        "#race to the ace\n",
        "#amount of draws until we see the first ace\n",
        "\n",
        "def simulation():\n",
        "  deck = Deck()\n",
        "  deck.shuffle()\n",
        "  drawn_cards = 0\n",
        "\n",
        "  while not deck.empty():\n",
        "    card = deck.draw()\n",
        "    drawn_cards += 1\n",
        "    if card[0] == 'ace':\n",
        "      return drawn_cards\n",
        "\n",
        "results = [simulation() for _ in range(100000)]\n",
        "print(sum(results) / len(results))"
