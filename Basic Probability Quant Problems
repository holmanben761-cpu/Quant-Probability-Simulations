        "#random card generator\n",
        "\n",
        "import random\n",
        "\n",
        "suits = ['diamonds', 'clubs', 'hearts', 'spades']\n",
        "numbers = ['ace', '2', '3', '4', '5', '6', '7', '8', '9', '10', 'jack', 'queen', 'king']\n",
        "\n",
        "#makes a deck, shuffles it and takes the bottom card\n",
        "class Deck:\n",
        "  def __init__(self):\n",
        "    self.cards = [(number, suit) for number in numbers for suit in suits]\n",
        "\n",
        "  def shuffle(self):\n",
        "    random.shuffle(self.cards)\n",
        "\n",
        "  def draw(self):\n",
        "    return self.cards.pop()\n",
        "\n",
        "  def empty(self):\n",
        "    return self.cards == []\n",
        "\n",
        "deck = Deck()\n",
        "deck.shuffle()\n",
        "\n",
        "card = deck.draw()\n",
        "print(card[0] + \" of \" + card[1])\n",
        "\n",
        "#fair dice roll\n",
        "\n",
        "\n",
        "class Dice:\n",
        "    def __init__(self, n=6):\n",
        "        self.sides = list(range(1, n + 1))\n",
        "\n",
        "    def roll(self):\n",
        "        return random.choice(self.sides)\n",
        "\n",
        "dice = Dice(6)\n",
        "print(dice.roll())\n",
        "\n",
        "#coin flip\n",
        "\n",
        "class Coin:\n",
        "  def __init__(self, p = 1/2):\n",
        "    self.side = ['heads', 'tails']\n",
        "    self.p = p\n",
        "  def flip(self):\n",
        "        if random.random() < self.p:\n",
        "            return 'heads'\n",
        "        return 'tails'\n",
        "\n",
        "coin = Coin(1/2)\n",
        "print(coin.flip())\n"
      ],
