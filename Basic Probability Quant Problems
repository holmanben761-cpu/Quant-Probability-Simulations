        "#expected number of consecutive flips\n",
        "#a coin is flipped 100 times. What is the expected number of the the longest consecutive flip chain\n",
        "\n",
        "def simulation():\n",
        "  coin = Coin(1/2)\n",
        "  head_streak = 0\n",
        "  tail_streak = 0\n",
        "  max_streak = 0\n",
        "\n",
        "\n",
        "  for _ in range(100):\n",
        "    side = coin.flip()\n",
        "\n",
        "    if side == 'heads':\n",
        "      head_streak += 1\n",
        "      tail_streak = 0\n",
        "\n",
        "    if side == 'tails':\n",
        "      tail_streak += 1\n",
        "      head_streak = 0\n",
        "\n",
        "    if head_streak > max_streak:\n",
        "      max_streak = head_streak\n",
        "\n",
        "    if tail_streak > max_streak:\n",
        "      max_streak = tail_streak\n",
        "\n",
        "  return max_streak\n",
        "\n",
        "results = [simulation() for _ in range (100000)]\n",
        "print(sum(results) / len(results))\n"
