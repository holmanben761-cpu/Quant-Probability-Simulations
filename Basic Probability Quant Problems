        "#highest roll evaluation\n",
        "#Jim will roll a fair, six-sided die until he gets a 4. What is the expected value of the highest number he rolls through this process?\n",
        "\n",
        "\n",
        "def simulation():\n",
        "  dice = Dice(6)\n",
        "  rolled_four = False\n",
        "  highest_number = 0\n",
        "\n",
        "  while rolled_four == False:\n",
        "    roll = dice.roll()\n",
        "    if roll > highest_number:\n",
        "      highest_number = roll\n",
        "    if roll == 4:\n",
        "      rolled_four = True\n",
        "      return highest_number\n",
        "\n",
        "results = [simulation() for _ in range(100000)]\n",
        "print(sum(results) / len(results))\n"
