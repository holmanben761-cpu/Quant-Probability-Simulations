        "#race to 7 heads\n",
        "#Stefan flips a coin 100 times. What is the probability there are 7 heads in a row\n",
        "\n",
        "def simulation():\n",
        "  coin = Coin(1/2)\n",
        "  head_streak = 0\n",
        "  max_head_streak = 0\n",
        "\n",
        "\n",
        "  for _ in range(100):\n",
        "    side = coin.flip()\n",
        "\n",
        "    if side == 'heads':\n",
        "      head_streak += 1\n",
        "\n",
        "    if side == 'tails':\n",
        "      head_streak = 0\n",
        "\n",
        "    if head_streak > max_head_streak:\n",
        "      max_head_streak = head_streak\n",
        "\n",
        "    if max_head_streak >= 7:\n",
        "      return 1\n",
        "\n",
        "  return 0\n",
        "\n",
        "\n",
        "results = [simulation() for _ in range (100000)]\n",
        "print(sum(results) / len(results))\n",
        "\n"
